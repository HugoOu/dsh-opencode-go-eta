{
  "name": "dsh-opencode-go-eta",
  "version": "0.1.1",
  "type": "module",
  "description": "OpenCode Go quota widget for DeepSeek Harness: samples the plan a few times a day, projects when the monthly allowance runs out, and compares that ETA with the renewal date.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "quota",
    "usage"
  ],
  "license": "MIT",
  "author": "HugoOu <yuhao.ou@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoOu/dsh-opencode-go-eta.git"
  },
  "homepage": "https://github.com/HugoOu/dsh-opencode-go-eta#readme",
  "bugs": {
    "url": "https://github.com/HugoOu/dsh-opencode-go-eta/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/projection.test.mjs && node test/host.test.mjs && node test/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
